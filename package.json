{
  "name": "agrandir-image",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Agrandir une image avec l'IA (Real-ESRGAN), 100 % dans le navigateur : WebGPU, sinon WebAssembly.",
  "homepage": "https://agrandir-image.fr",
  "repository": { "type": "git", "url": "git+https://github.com/Recreabox/agrandir-image.git" },
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "node scripts/prepare-assets.mjs && astro dev",
    "build": "node scripts/prepare-assets.mjs && astro build && node scripts/postbuild.mjs",
    "preview": "wrangler dev --port 8788",
    "deploy": "npm run build && wrangler deploy",
    "build:test": "cp tools/test/pages/test-moteur.astro src/pages/test-moteur.astro && npm run build; rm -f src/pages/test-moteur.astro"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.1.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "astro": "^7.4.0",
    "fflate": "^0.8.3",
    "onnxruntime-web": "^1.30.0",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "wrangler": "^4.151.1"
  }
}
