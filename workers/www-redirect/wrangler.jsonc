{
  // Worker de redirection www → domaine principal. Domaine personnalisé www.agrandir-image.fr
  // rattaché par l'API Cloudflare (PUT /accounts/{id}/workers/domains), pas déclaré ici.
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "agrandir-image-www",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
