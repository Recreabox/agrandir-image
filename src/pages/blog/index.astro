---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const fmtDate = (d: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(d);
---
<Base title="Blog : agrandir et préparer ses images" description="Guides pratiques pour agrandir une image, préparer une impression, dimensionner des photos produits ou un logo, et comprendre ce que l’IA sait faire." crumbs={[{ name: 'Blog', href: '/blog/' }]}>
  <section class="hero wrap">
    <h1>Blog</h1>
    <p>Des guides simples pour préparer vos images : impression, boutique en ligne, logo, et ce que l’IA sait vraiment faire.</p>
  </section>
  <ul class="posts wrap">
    {posts.map((p) => (
      <li>
        <a href={'/blog/' + p.id + '/'}>
          <span class="posts__t">{p.data.title}</span>
          <span class="posts__d">{p.data.description}</span>
          <span class="posts__m">{fmtDate(p.data.publishedAt)} · {p.data.readingMinutes} min de lecture</span>
        </a>
      </li>
    ))}
  </ul>
</Base>

<style>
  .posts { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); gap: 16px; max-width: 880px; margin-top: 8px; padding: 0; list-style: none; }
  .posts a { display: grid; gap: 8px; height: 100%; padding: 20px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--card); text-decoration: none; transition: border-color .15s, box-shadow .15s; }
  .posts a:hover { border-color: var(--primary-200); box-shadow: var(--shadow); }
  .posts__t { color: var(--ink); font-size: 17px; font-weight: 600; line-height: 1.35; }
  .posts a:hover .posts__t { color: var(--primary); }
  .posts__d { color: var(--muted); font-size: 14px; line-height: 1.55; }
  .posts__m { margin-top: auto; color: var(--faint); font-size: 13px; }
</style>
