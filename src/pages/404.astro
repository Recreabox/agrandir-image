---
import Base from '../layouts/Base.astro';
import { TOOLS } from '../lib/site';
---
<Base title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex>
  <section class="hero wrap">
    <h1>Page introuvable</h1>
    <p>Cette page n’existe pas ou a été déplacée.</p>
  </section>
  <ul class="nf wrap">{TOOLS.map((t) => (<li><a href={t.href}>{t.label}</a></li>))}</ul>
</Base>
<style>
  .nf { display: grid; justify-items: center; gap: 6px; padding: 0; list-style: none; }
  .nf a { color: var(--primary); }
</style>
