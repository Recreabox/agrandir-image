---
interface Props { items: { q: string; a: string }[]; title?: string }
const { items, title = 'Questions fréquentes' } = Astro.props;
---
<section class="faq" aria-labelledby="faq-titre">
  <h2 id="faq-titre">{title}</h2>
  <div class="faq__list">
    {items.map((it) => (
      <details class="faq__item">
        <summary>
          <h3>{it.q}</h3>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
        </summary>
        <div class="faq__a" set:html={it.a} />
      </details>
    ))}
  </div>
</section>

<style>
  .faq { margin-top: 48px; }
  .faq h2 { margin: 0; font-size: 18px; font-weight: 600; }
  .faq__list { margin: 12px 0 0; }
  .faq__item { margin: 0; border-bottom: 1px solid var(--border); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 14px 0; cursor: pointer; list-style: none; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__item h3 { margin: 0; font-size: 15px; font-weight: 400; line-height: 1.45; color: var(--ink-2); }
  .faq__item summary:hover h3 { color: var(--ink); }
  .faq__item svg { width: 16px; height: 16px; flex: none; fill: none; stroke: var(--muted); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform .15s; }
  .faq__item[open] svg { transform: rotate(180deg); }
  .faq__a { padding: 0 0 16px; color: var(--muted); font-size: 15px; line-height: 1.7; }
  .faq__a :global(p + p) { margin-top: 8px; }
  .faq__a :global(a) { color: var(--primary); }
</style>
