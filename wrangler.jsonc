{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Domaine agrandir-image.fr rattaché par l'API Cloudflare (Workers Custom Domains), pas via "routes" :
  // le jeton de déploiement n'a pas les droits de zone. www est redirigé par workers/www-redirect.
  "name": "agrandir-image",
  "main": "workers/main/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": false }
}
